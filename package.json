{
  "name": "master-gem-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "npm run dev:workforce",
    "dev:core": "npm run dev --workspace @master-gem/core",
    "dev:workforce": "npm run dev --workspace @master-gem/workforce",
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build --workspace @master-gem/core",
    "build:workforce": "npm run build --workspace @master-gem/workforce",
    "preview": "npm run preview:workforce",
    "preview:core": "npm run preview --workspace @master-gem/core",
    "preview:workforce": "npm run preview --workspace @master-gem/workforce",
    "serve": "node scripts/preview-server.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:boundaries": "node --test tests/workspaceBoundary.test.mjs",
    "test:core": "node scripts/run-tests.mjs core",
    "test:workforce": "node scripts/run-tests.mjs workforce"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
